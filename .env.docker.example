# Copy this file to .env before running Docker Compose. Do not commit .env.
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=lrms
POSTGRES_USER=lrms
POSTGRES_PASSWORD=use-a-unique-local-password
WEB_PORT=8000

# Local Docker defaults. Set these for a public HTTPS deployment.
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Optional one-time initial tenant/admin. Set false after the first successful start.
BOOTSTRAP_LRMS=false
BOOTSTRAP_TENANT_NAME=Demo Tenant
BOOTSTRAP_TENANT_SLUG=demo-tenant
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
